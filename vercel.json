{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/coach.ts": {
      "maxDuration": 60,
      "includeFiles": "coach/**"
    },
    "api/lumina-tts.ts": {
      "maxDuration": 60,
      "includeFiles": "coach/**"
    },
    "api/gemini-probe.ts": {
      "maxDuration": 30,
      "includeFiles": "coach/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
