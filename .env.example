# =============================================================================
# Local: copy this file → `.env.local` (gitignored). Use the SAME variable names
# on Vercel (Project → Settings → Environment Variables) — no renaming.
#
# • Server secrets (`GEMINI_*`, `ELEVENLABS_*`): Vercel “Serverless”; also in
#   `.env.local` for `npm run dev` / `npm run coach-api`.
# • `VITE_*`: set on Vercel for Preview + Production (build-time inlined).
# • Optional sync: `vercel link && vercel env pull .env.local` (CLI pulls dashboard
#   into local — useful to match preview).
# Never hardcode API keys in source; they leak in bundles or git history.
# =============================================================================
#
# --- Google Gemini (AI Studio — server-side only; no VITE_ prefix!) ------------
# Vercel: use exactly GEMINI_API_KEY (not NEXT_PUBLIC_* — we're Vite + serverless `/api/coach`).
# Docs: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=

# Gemini REST host (normally leave default)
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Flash‑Lite (default): lighter quotas than full Flash — see Gemini “Models”
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# Optional — enables GET /api/gemini-probe live call (needs Authorization: Bearer <this value>)
# GEMINI_DEBUG_TOKEN=

# Sidecar relay for `vite preview` — proxies `/api/coach`
COACH_API_PORT=8788

# If SPA and API hosted separately at build — still never put GEMINI_* in VITE_*:
# VITE_COACH_API_ORIGIN=https://your-api.example.com

# --- ElevenLabs (neural Lumina Voice — keys stay SERVER-SIDE ONLY) -------------
# Dashboard: https://elevenlabs.io — copy a Voice ID under Voices (young / expressive fits Lumina).
# Dev: `/api/lumina-tts` handled by `vite.config.ts`; preview: proxy → `npm run coach-api`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional; default inside code is Turbo v2.5 (`eleven_turbo_v2_5`).
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Client: `'1'` or `'true'` uses neural speech (falls back to Web Speech API if relay errors).
VITE_LUMINA_USE_ELEVENLABS=1

# Optional Open-Meteo coordinates
VITE_WEATHER_LAT=
VITE_WEATHER_LON=
